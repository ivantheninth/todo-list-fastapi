POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database

DATABASE_URL=postgresql+asyncpg://your_user:your_password@postgres:5432/your_database

TEST_DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:5432/your_test_database

ALEMBIC_DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:5432/your_database

FRONTEND_ORIGIN=http://localhost:8080

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=your_openai_model
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1000

GHCR_OWNER=your_github_username

JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_HTTPONLY=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
CSRF_TRUSTED_ORIGINS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_OAUTH_COOKIE_SECURE=true
GOOGLE_OAUTH_STATE_MAX_AGE_SECONDS=300
GOOGLE_OAUTH_TIMEOUT_SECONDS=10.0

LOG_LEVEL=INFO

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
